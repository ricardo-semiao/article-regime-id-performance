@phdthesis{Medeiros2000,
  author = {Marcelo Cunha Medeiros},
  title = {Modelos com múltiplos regimes para séries temporais limiares, transições suaves, e redes neurais},
  school = {Pontifícia Universidade Católica do Rio de Janeiro, Departamento de Engenharia Elétrica},
  year = {2000},
  note = {Tese (doutorado) - Pontifícia Universidade Católica do Rio de Janeiro, Departamento de Engenharia Elétrica. Bibliografia: f. 111-115. Acesso restrito aos usuários cadastrados no Sistema de Bibliotecas da PUC-Rio. Também disponível na forma impressa. Reprodução eletrônica. Niterói, R.J. : Outservice Eletrônica, 2003. Modo de acesso: World Wide Web. Exigências do sistema: conexão com a Internet, World Wide Web browser e Adobe Acrobat Reader},
  keywords = {Análise de séries temporais, Engenharia elétrica -- Teses},
  abstract = {O objetivo desta tese é apresentar modelos mais flexíveis com troca de regimes, combinando as idéias provenientes dos modelos com limiar, com transição suave e redes neurais. Os modelos aqui discutidos possuem múltiplos regimes e a transição entre eles é controlada por uma combinação linear de variáveis conhecidas. Um procedimento de modelagem, baseada no trabalho de Teräsvirta e Lin (1993), Eiterheim e Teräsvirta (1996), e Rech, Teräsvirta e Tschernig (1999), consistindo das etapas de especificação, estimação e avaliação, foi desenvolvido, desta forma possibilitando ao analista de séries temporais escolher entre diferentes alternativas durante o processo de modelagem.},
  advisor = {Álvaro de Lima Veiga Filho},
  url = {https://doi.org/10.17771/PUCRio.acad.7549},
  id = {puc.131716},
  pages = {xiv, 115 f. ; 30 cm}
}
